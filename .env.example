# Client (build time, optional). Only needed if the game server is hosted on a
# different origin than the web page. Default: same origin, path /ws.
# VITE_SERVER_URL=wss://classic-strike.fly.dev/ws

# Server (runtime)
PORT=8080
STATIC_DIR=dist
# Comma-separated list of allowed page origins for WebSocket connections.
# Empty = allow any origin.
ALLOWED_ORIGINS=
# Test-only hooks (teleport). NEVER enable in production.
CS_DEBUG=0
